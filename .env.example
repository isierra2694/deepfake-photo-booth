# Share backend configuration. Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# Port the share server listens on (keep separate from deep-live-cam :8000 and live-server :3000).
PORT=8787

# Origin allowed to call the share API (the page served by live-server).
ALLOWED_ORIGIN=http://localhost:3000

# --- Vercel Blob ---
# From your Vercel Blob store: Storage -> your store -> Tokens.
BLOB_READ_WRITE_TOKEN=

# --- Email Lambda ---
EMAIL_LAMBDA_URL=https://o6prusgwzk2k7axom67ihzhrgm0hyuge.lambda-url.us-east-1.on.aws/
# Paste only the token here; the backend adds the Authorization: Bearer prefix.
EMAIL_LAMBDA_TOKEN=
